{
  "name": "text-tools",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.5",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.3",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/roboto": "^5.3.0",
    "@ngrx/signals": "^22.0.0",
    "codemirror": "^6.0.2",
    "idb": "^8.0.3",
    "material-symbols": "^0.47.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
}
